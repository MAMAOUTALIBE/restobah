# Local development. Copy to .env and generate DJANGO_SECRET_KEY.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
DATABASE_URL=sqlite:///backend/db.sqlite3
FRONTEND_URL=http://localhost:5173
STC_DEMO_MODE=1
STC_PAYMENT_MODE=simulation
# Optional public client information; empty fields are hidden in the footer.
STC_CONTACT_PHONE=
STC_CONTACT_EMAIL=
STC_LEGAL_NOTICE_URL=
STC_PRIVACY_URL=
STC_TERMS_URL=
STC_CONTENT_APPROVED=0
# Never put secrets in VITE_* variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local e-mails (reset links, order confirmations) are written with private permissions to backend/.private-emails/.
EMAIL_BACKEND=shop.email_backend.PrivateFileEmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=STC <bonjour@stc.example>
# Team address(es) alerted of each confirmed order, comma separated.
STC_ORDER_NOTIFICATION_EMAIL=
# Docker only; use a unique password (setup script generates one).
POSTGRES_PASSWORD=
