{
  "name": "stc-restaurant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "python3 scripts/e2e.py",
    "dev:all": "python3 scripts/dev.py",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test:backend": "backend/.venv/bin/python backend/manage.py test shop --noinput",
    "check": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.5"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
