# Production requires real identity, TLS/domain and tested external services.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=restaurant.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://restaurant.example.com
FRONTEND_URL=https://restaurant.example.com
STC_DOMAIN=restaurant.example.com
SECURE_SSL_REDIRECT=1
STC_DEMO_MODE=0
# Client delivery: real orders, physical payment recorded by authorized staff.
# This is not an online debit or a cash-register certification.
STC_PAYMENT_MODE=on_site
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public client information: supply actual values, never private document tokens.
STC_CONTACT_PHONE=
STC_CONTACT_EMAIL=
STC_LEGAL_NOTICE_URL=
STC_PRIVACY_URL=
STC_TERMS_URL=
# Set to 1 only after the client's responsible person approves all actual content.
STC_CONTENT_APPROVED=0
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=REPLACE
EMAIL_HOST_PASSWORD=REPLACE
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=STC <bonjour@restaurant.example.com>
# Team address(es) alerted of each confirmed order, comma separated.
STC_ORDER_NOTIFICATION_EMAIL=cuisine@restaurant.example.com
# Used only for legacy/test Stripe orders, not for physical payments.
STC_PENDING_PAYMENT_MINUTES=45
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
